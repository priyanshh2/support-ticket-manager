{
  "name": "support-ticket-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Mini Support Ticket Manager",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "server:start": "npm --prefix server start",
    "client:build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

